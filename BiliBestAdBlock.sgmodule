#!name=BiliBestAdBlock · Bilibili 净化
#!url=https://raw.githubusercontent.com/Enderherman/BiliBestAdBlock/main/BiliBestAdBlock.sgmodule
#!desc=搜索广告、信息流广告、开屏和直播推广；隐藏搜索发现并精简“我的”页。基于 Bilibili增强、BiliIntlClean，补充 All-in-One 独立规则。
#!author=Enderherman（整理）；参考 lushier888 / kokoryh / iab0x00 / letswish / zirawell
#!category=Enhancement
#!arguments=动态最常访问:auto,创作中心:0,过滤置顶评论广告:1,优化评论区加载:bilibili.request,空降助手:bilibili.airborne,空降助手策略:DIRECT,日志等级:4
#!arguments-desc=动态最常访问：auto/show/hide；创作中心：0 隐藏，1 显示；过滤置顶评论广告：0 关闭，1 开启；优化评论区加载与空降助手设为 # 可关闭；日志等级：1 DEBUG，2 INFO，3 WARN，4 ERROR，5 OFF。
# 上游：https://raw.githubusercontent.com/lushier888/QX-Surge-Loon-Shadowrocket/main/SurgeModule/BilibiliAD.sgmodule
# 上游：https://raw.githubusercontent.com/iab0x00/ProxyRules/main/Rewrite/BiliIntlClean.sgmodule
# 上游：https://raw.githubusercontent.com/letswish/Shadowrocket-Module/main/All-in-One-AdBlock.sgmodule
# 只供单独启用；请关闭上述三个原模块中的 Bilibili 重叠规则。

[Rule]
# Bilibili增强：空降助手与广告/追踪域名
DOMAIN,bsbsb.top,{{{空降助手策略}}}
DOMAIN,api.biliapi.com,REJECT,pre-matching,extended-matching
DOMAIN,app.biliapi.com,REJECT,pre-matching,extended-matching
DOMAIN,api.biliapi.net,REJECT,pre-matching,extended-matching
DOMAIN,app.biliapi.net,REJECT,pre-matching,extended-matching
AND,((DOMAIN-SUFFIX,chat.bilibili.com), (OR,((DOMAIN-KEYWORD,stun), (DOMAIN-KEYWORD,tracker)))),REJECT,pre-matching
# All-in-One：Bilibili 独立广告域名
DOMAIN-SUFFIX,cm.ad.bilibili.com,REJECT
DOMAIN-SUFFIX,cm.adcommon.bilibili.com,REJECT
DOMAIN-SUFFIX,cm.game.bilibili.com,REJECT
DOMAIN-SUFFIX,cm.track.biligame.bilibili.com,REJECT

[Map Local]
# Bilibili增强：活动、直播电商、青少年模式等广告/推广接口
^https:\/\/ap[ip]\.bilibili\.com\/x\/(?:resource\/(?:top\/activity|patch\/tab(?:\/v2)?)|vip\/ads\/materials)\? header="content-type: application/json" data-type=text data="{"code":-404,"message":"-404","ttl":1,"data":null}"
^https:\/\/api\.bilibili\.com\/pgc\/activity\/deliver\/material\/receive\? header="content-type: application/json" data-type=text data="{"code":0,"data":{"closeType":"close_win","container":[],"showTime":""},"message":"success"}"
^https:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v1\/ecommerce-user\/get_shopping_info\? header="content-type: application/json" data-type=text data="{}"
^https:\/\/line3-h5-mobile-api\.biligame\.com\/game\/live\/large_card_material\? header="content-type: application/json" data-type=text data="{"code":0,"message":"success"}"
^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.interface\.v1\.Teenagers\/ModeStatus$ header="content-type: application/grpc|grpc-status: 0" data-type=base64 data="AAAAABMKEQgCEgl0ZWVuYWdlcnMgAioA"
^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.(?:view\.v1\.View\/TFInfo|viewunite\.v1\.View\/(?:PlayPause|ViewEndPage))$ header="content-type: application/grpc|grpc-status: 0" data-type=base64 data="AAAAAAA="
# BiliIntlClean：隐藏热搜与搜索发现；不匹配 Search/SearchAll
^https:\/\/app\.bilibili\.com\/x\/v2\/search\/square\?(.*)$ data-type=text data="{}" status-code=200

[URL Rewrite]
# All-in-One：与 Bilibili增强不同的独立接口
^https?:\/\/api\.bilibili\.com\/x\/v2\/dm\/qoe\/show\? - reject-dict
^https?:\/\/upos-sz-static\.bilivideo\.com\/ssaxcode\/\w{2}\/\w{2}\/\w{32}-1-SPLASH - reject-img
^https?:\/\/api\.bilibili\.com\/x\/mengqi\/v\d\/resource\? - reject-dict

[Body Rewrite]
# Bilibili增强：弹幕追踪、番剧支付信息、影视频道推广
http-response-jq ^https:\/\/api\.bilibili\.com\/x\/pd-proxy\/tracker\? '.data[][]?="stun.chat.bilibili.com:3478"'
http-response-jq ^https:\/\/api\.bilibili\.com\/pgc\/view\/v2\/app\/season\? 'del(.data.payment)'
http-response-jq ^https:\/\/api\.bilibili\.com\/pgc\/page\/channel\? '.data.modules |= map(select(.type != "TIP") | if .type == "BANNER" then .module_data.items |= map(select(.url | startswith("https://www.bilibili.com/blackboard/era/") | not)) else . end)'
# BiliIntlClean：移除四个指定入口；按参数隐藏“创作中心”。缺少该数据结构时原样返回
http-response-jq ^https:\/\/app\.bilibili\.com\/x\/v2\/account\/mine\? 'if (.data.sections_v2 | type) == "array" then (if (.data.sections_v2[1].items | type) == "array" then .data.sections_v2[1].title = null | .data.sections_v2[1].items |= map(select(.title != "联系客服" and .title != "稿件管理" and .title != "我的钱包" and .title != "我的NFT")) else . end) | (if {{{创作中心}}} == 0 then .data.sections_v2 |= map(select(.title != "创作中心")) else . end) else . end'

[Script]
# Bilibili增强：搜索广告由 Sparkle 的 Protobuf 响应脚本处理
{{{空降助手}}} = type=http-request,pattern=^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.community\.service\.dm\.v1\.DM\/DmSegMobile$,argument="{"logLevel":"{{{日志等级}}}"}",requires-body=1,binary-body-mode=1,max-size=-1,engine=webview,timeout=10,script-path=https://raw.githubusercontent.com/kokoryh/Sparkle/refs/heads/master/dist/bilibili.protobuf.request.js
{{{优化评论区加载}}} = type=http-request,pattern=^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.(?:app\.viewunite\.v1\.View\/View|main\.community\.reply\.v1\.Reply\/MainList)$,argument="{"purifyComment":{{{过滤置顶评论广告}}},"logLevel":"{{{日志等级}}}"}",requires-body=1,binary-body-mode=1,max-size=-1,engine=webview,timeout=10,script-path=https://raw.githubusercontent.com/kokoryh/Sparkle/refs/heads/master/dist/bilibili.protobuf.request.js
bilibili.skin = type=http-response,pattern=^https:\/\/app\.bilibili\.com\/x\/resource\/show\/skin\?,requires-body=1,max-size=-1,engine=webview,script-path=https://raw.githubusercontent.com/kokoryh/Script/master/js/bili-suit-diy.js
bilibili.live = type=http-response,pattern=^https:\/\/api\.live\.bilibili\.com\/xlive\/(?:app-interface\/v2\/index\/feed|app-room\/v1\/index\/getInfoBy(?:Room|User))\?,requires-body=1,max-size=-1,engine=webview,script-path=https://raw.githubusercontent.com/kokoryh/Sparkle/refs/heads/master/dist/bilibili.json.js
# “我的”主页面由上面的 jq 独占；Sparkle 仍处理 iPad 我的页及账号信息
bilibili.json = type=http-response,pattern=^https:\/\/app\.bilibili\.com\/x\/(?:resource\/show\/tab\/v2|v2\/(?:splash\/(?:list|show|event\/list2)|feed\/index(?:\/story)?|account\/(?:mine\/ipad|myinfo)))\?,argument="{"showCreatorHub":{{{创作中心}}}}",requires-body=1,max-size=-1,engine=webview,script-path=https://raw.githubusercontent.com/kokoryh/Sparkle/refs/heads/master/dist/bilibili.json.js
bilibili.protobuf = type=http-response,pattern=^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.(?:app\.(?:show\.v1\.Popular\/Index|dynamic\.v2\.Dynamic\/DynAll|view(?:unite)?\.v1\.View\/(?:View|ViewProgress|RelatesFeed)|playurl\.v1\.PlayURL\/PlayView|playerunite\.v1\.Player\/PlayViewUnite)|polymer\.app\.search\.v1\.Search\/SearchAll|community\.service\.dm\.v1\.DM\/DmView|main\.community\.reply\.v1\.Reply\/MainList|pgc\.gateway\.player\.v2\.PlayURL\/PlayView)$,argument="{"displayUpList":"{{{动态最常访问}}}","purifyComment":{{{过滤置顶评论广告}}},"sponsorBlock":"{{{空降助手}}}","logLevel":"{{{日志等级}}}"}",requires-body=1,binary-body-mode=1,max-size=-1,engine=webview,script-path=https://raw.githubusercontent.com/kokoryh/Sparkle/refs/heads/master/dist/bilibili.protobuf.response.js
# All-in-One：观影页推广卡，独立于 Bilibili增强 的 PGC channel/season 规则
bilibili.json.pgc = type=http-response,pattern=^https?:\/\/api\.bilibili\.com\/pgc\/page\/(?:bangumi|cinema\/tab\?),requires-body=1,max-size=0,engine=webview,script-path=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/bilibiliJson.js

[MITM]
hostname = %APPEND% grpc.biliapi.net, app.bilibili.com, api.bilibili.com, api.live.bilibili.com, line3-h5-mobile-api.biligame.com, upos-sz-static.bilivideo.com
